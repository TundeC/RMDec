\name{seizures}
\alias{seizures}
\docType{data}
\title{Seizure Diary Data}
\description{
Seizure counts from an observational study of adults with epilepsy.
}
\usage{data(seizures)}
\format{
A data frame with 500 rows and 5 variables:
\describe{
  \item{\code{id}}{Patient identifier.}
  \item{\code{seizures}}{Number of seizures recorded during follow-up.}
  \item{\code{followup}}{Length of follow-up (days).}
  \item{\code{age}}{Age at entry to the study (years).}
  \item{\code{treatment}}{Anti-epileptic regimen: a factor with levels
    \code{standard} and \code{new}.}
}
}
\keyword{datasets}
