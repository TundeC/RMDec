\name{cognition}
\alias{cognition}
\docType{data}
\title{Cognitive Function Data}
\description{
Memory test scores, clinical variables and blood biomarkers for adults with
epilepsy.
}
\usage{data(cognition)}
\format{
A data frame with 400 rows and 16 variables:
\describe{
  \item{\code{id}}{Patient identifier.}
  \item{\code{score}}{Memory test score (higher is better).}
  \item{\code{age}}{Age (years).}
  \item{\code{duration}}{Time since diagnosis (years).}
  \item{\code{education}}{Years of full-time education.}
  \item{\code{sleep}}{Average sleep (hours per night).}
  \item{\code{seizures_month}}{Average number of seizures per month.}
  \item{\code{n_drugs}}{Number of anti-epileptic drugs taken.}
  \item{\code{m1}, \code{m2}, \code{m3}, \code{m4}, \code{m5}, \code{m6},
    \code{m7}, \code{m8}}{Blood biomarkers (standardised units).}
}
}
\keyword{datasets}
